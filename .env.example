# Публічні змінні фронтенду (Vite вбудовує їх у бандл під час збірки)

# Канонічна адреса сайту — використовується для canonical, Open Graph і JSON-LD.
VITE_SITE_URL="https://servicehubmaster.com"

# Необов'язково: Google Analytics 4 (наприклад G-XXXXXXXXXX). Порожнє значення = аналітика вимкнена.
VITE_GA_MEASUREMENT_ID=""

# Необов'язково: webhook-ендпоінти для заявок.
# Мають приймати POST із JSON та дозволяти CORS із вашого домену.
# Якщо не задані — форма відкриває WhatsApp із готовим текстом заявки (без фейкового «успіху»).
VITE_BOOKING_WEBHOOK_URL=""
VITE_CONTACT_WEBHOOK_URL=""
